---
layout: default
---
{%- assign lang = site.active_lang -%}
{%- assign t = site.data[lang].strings -%}
{%- assign resume_key = lang | prepend: 'resume_' -%}
{%- assign cv = site.data[resume_key] -%}
{%- assign talks = site.data[lang].talks | where_exp: 'talk', 'talk.publications != false' -%}
<div class="wrap">
  <header class="page-head">
    <h1>{{ cv.basics.name }}</h1>
    <p class="lead">{{ cv.basics.label }} · {{ cv.basics.location.address }}</p>
    <ul class="cv-tools">
      <li>
        <a href="mailto:{{ cv.basics.email }}">{{ cv.basics.email }}</a>
      </li>
      {% for profile in cv.basics.profiles -%}
        <li>
          <a class="ext" href="{{ profile.url }}">{{ profile.network }}</a>
        </li>
      {%- endfor %}
      <li>
        <button type="button" data-print>{{ t.cv.print }}</button>
      </li>
    </ul>
  </header>

  <section class="section" aria-labelledby="summary">
    <header class="section-head">
      <h2 id="summary">{{ t.cv.summary }}</h2>
    </header>
    <dl class="cv-summary">
      {% for item in cv.basics.highlights -%}
        <div>
          <dt class="figure-number">
            {{- item.figure -}}
            {%- if item.unit -%}
              <span class="unit">{{ item.unit }}</span>
            {%- endif -%}
          </dt>
          <dd>{{ item.text }}</dd>
        </div>
      {%- endfor %}
    </dl>
  </section>

  <div class="cv-pair">
    <section class="section" aria-labelledby="education">
      <header class="section-head">
        <h2 id="education">{{ t.cv.education }}</h2>
      </header>
      <ul class="ruled">
        {% for item in cv.education -%}
          <li class="cv-entry">
            <p class="period">
              {{- item.startDate | date: '%Y' }} – {{ item.endDate | date: '%Y' -}}
              {%- if item.expected %}{{ t.cv.expected }}{% endif -%}
            </p>
            <h3>
              {{ item.studyType -}}
              {{- t.cv.degree_in -}}
              {{- item.area }}
            </h3>
            <p class="org">
              <a href="{{ item.url }}">{{ item.institution }}</a>
            </p>
            {% if item.summary %}
              <p class="note">{{ item.summary }}</p>
            {% endif %}
          </li>
        {%- endfor %}
      </ul>
    </section>

    <section class="section" aria-labelledby="experience">
      <header class="section-head">
        <h2 id="experience">{{ t.cv.experience }}</h2>
      </header>
      <ul class="ruled">
        {% for item in cv.work -%}
          <li class="cv-entry">
            <p class="period">{{ item.startDate | date: '%Y.%m' }} – {{ item.endDate | date: '%Y.%m' }}</p>
            <h3>{{ item.position }}</h3>
            <p class="org">
              <a href="{{ item.url }}">{{ item.name }}</a>
              {%- if item.description %} · {{ item.description }}{% endif %}
            </p>
            {% if item.summary and item.highlights == null %}
              <p class="note">{{ item.summary }}</p>
            {% endif %}
            {% if item.highlights -%}
              <ul class="bullets">
                {% for highlight in item.highlights -%}
                  <li>{{ highlight }}</li>
                {%- endfor %}
              </ul>
            {%- endif %}
          </li>
        {%- endfor %}
      </ul>
    </section>
  </div>

  <section class="section" aria-labelledby="projects">
    <header class="section-head">
      <h2 id="projects">{{ t.cv.projects }}</h2>
      <a class="more" href="{{ '/projects/' | relative_url }}">
        {{- t.cv.all_projects -}}
        <span class="arrow" aria-hidden="true">→</span></a
      >
    </header>
    <ul class="cv-rows">
      {% for item in cv.projects -%}
        <li>
          <span class="period">{{ item.period }}</span>
          <span>
            <span class="title">{{ item.name }}</span>
            <span class="text">{{ item.description }}</span>
          </span>
          <span class="tag">{{ item.entity }}</span>
        </li>
      {%- endfor %}
    </ul>
  </section>

  <section class="section" aria-labelledby="publications">
    <header class="section-head">
      <h2 id="publications">{{ t.cv.publications }}</h2>
      <a class="more" href="{{ '/publications/' | relative_url }}">
        {{- t.cv.all_publications -}}
        <span class="arrow" aria-hidden="true">→</span></a
      >
    </header>
    <div class="cv-refs">
      {% bibliography --query @article @inproceedings --group_by none --template bib_cv %}
      <ol class="bibliography">
        {% for talk in talks -%}
          <li>
            <div class="ref-row">
              <span class="abbr">
                {{- talk.kind }}
                {{ talk.year -}}
              </span>
              <div class="ref">
                <span class="me">{{ cv.basics.name }}</span>.
                <span
                  class="ref-title"
                  {% if talk.title_lang %}
                    lang="{{ talk.title_lang }}"
                  {% endif %}
                >
                  {{- talk.title -}}
                  {{- t.cv.period_mark -}}
                </span>
                <span class="ref-where">
                  {{- talk.where -}}
                  {{- t.cv.period_mark -}}
                </span>
              </div>
            </div>
          </li>
        {%- endfor %}
      </ol>
    </div>
  </section>

  <div class="cv-pair">
    <section class="section" aria-labelledby="honors">
      <header class="section-head">
        <h2 id="honors">{{ t.cv.honors }}</h2>
      </header>
      {%- assign groups = cv.awards | group_by: 'category' -%}
      {% for group in groups -%}
        <div class="cv-group">
          {% if group.name != '' %}
            <h3>{{ group.name }}</h3>
          {% endif %}
          <ul class="cv-rows two">
            {% for item in group.items -%}
              <li>
                {%- comment -%} full dates such as 2018-09-01 show the year; ranges such as "2018 – 2020" show as written {%- endcomment -%}
                {%- if item.year -%}
                  {%- assign when = item.year -%}
                {%- elsif item.date.size <= 10 -%}
                  {%- assign when = item.date | slice: 0, 4 -%}
                {%- else -%}
                  {%- assign when = item.date -%}
                {%- endif %}
                <span class="period">{{ when }}</span>
                <span>
                  <span class="title">{{ item.title }}</span>
                  {%- if item.awarder -%}
                    <span class="text">{{ item.awarder }}</span>
                  {%- endif -%}
                  {%- if item.summary -%}
                    <span class="text">{{ item.summary }}</span>
                  {%- endif -%}
                </span>
              </li>
            {%- endfor %}
          </ul>
        </div>
      {%- endfor %}
      {% if cv.certificates.size > 0 -%}
        <div class="cv-group">
          <h3>{{ t.cv.certificates }}</h3>
          <ul class="cv-rows two">
            {% for item in cv.certificates -%}
              <li>
                <span class="period">{{ item.date | slice: 0, 4 }}</span>
                <span>
                  <span class="title">{{ item.name }}</span>
                  {%- if item.issuer -%}
                    <span class="text">{{ item.issuer }}</span>
                  {%- endif -%}
                </span>
              </li>
            {%- endfor %}
          </ul>
        </div>
      {%- endif %}
    </section>

    <section class="section" aria-labelledby="ip">
      <header class="section-head">
        <h2 id="ip">{{ t.cv.ip }}</h2>
      </header>
      <div class="cv-ip-list">
        {% bibliography --query @misc[kind=patent || kind=software || kind=certificate] --group_by none --template bib_cv_ip %}
      </div>
    </section>
  </div>

  <div class="cv-pair">
    <section class="section" aria-labelledby="skills">
      <header class="section-head">
        <h2 id="skills">{{ t.cv.skills }}</h2>
      </header>
      <dl class="cv-skills">
        {% for skill in cv.skills -%}
          <div>
            <dt>
              {{ skill.name -}}
              {%- if skill.level -%}
                <span class="level">（{{ skill.level }}）</span>
              {%- endif %}
            </dt>
            <dd>{{ skill.keywords | join: t.cv.list_separator }}</dd>
          </div>
        {%- endfor %}
      </dl>
    </section>

    <div>
      {% if cv.interests.size > 0 -%}
        <section class="section" aria-labelledby="interests">
          <header class="section-head">
            <h2 id="interests">{{ t.cv.interests }}</h2>
          </header>
          <ul class="bullets">
            {% for item in cv.interests -%}
              <li>{{ item.name }}</li>
            {%- endfor %}
          </ul>
        </section>
      {%- endif %}

      <section class="section" aria-labelledby="languages">
        <header class="section-head">
          <h2 id="languages">{{ t.cv.languages }}</h2>
        </header>
        <dl class="cv-skills">
          {% for item in cv.languages -%}
            <div>
              <dt>{{ item.language }}</dt>
              <dd>{{ item.fluency }}</dd>
            </div>
          {%- endfor %}
        </dl>
      </section>

      <section class="section cv-activities" aria-labelledby="activities">
        <header class="section-head">
          <h2 id="activities">{{ t.cv.activities }}</h2>
        </header>
        <ul class="bullets">
          {% for item in cv.activities -%}
            <li>{{ item }}</li>
          {%- endfor %}
        </ul>
      </section>
    </div>
  </div>
</div>
