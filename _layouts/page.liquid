---
layout: default
---
{%- comment -%} A page with a title, an optional lead and free content. {%- endcomment -%}
<div class="wrap">
  <header class="page-head">
    <h1>{{ page.title }}</h1>
    {% if page.lead -%}
      <p class="lead">{{ page.lead }}</p>
    {%- endif %}
  </header>
  {{ content }}
</div>
