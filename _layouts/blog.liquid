---
layout: default
---
{%- assign t = site.data[site.active_lang].strings.blog -%}
<div class="wrap">
  <header class="page-head">
    <h1>{{ page.title }}</h1>
    <p class="lead">{{ t.lead }}</p>
    {% include category_index.liquid current='all' %}
  </header>
  <section class="section">
    {% include post_list.liquid posts=site.posts %}
  </section>
</div>
