---
layout: default
---
{%- assign t = site.data[site.active_lang].strings -%}
{%- assign toc = content | toc_only -%}
{%- assign has_toc = false -%}
{%- if page.toc and toc contains '<li' -%}{%- assign has_toc = true -%}{%- endif -%}
<article class="wrap" lang="{{ page.lang | default: 'zh-CN' }}">
  <header class="article-head">
    <a class="back" href="{{ '/blog/' | relative_url }}"><span class="arrow" aria-hidden="true">←</span>{{ t.blog.back }}</a>
    <h1>{{ page.title }}</h1>
    {% if page.description -%}
      <p class="lead">{{ page.description }}</p>
    {%- endif %}
    <p class="meta">
      <time datetime="{{ page.date | date: '%Y-%m-%d' }}">{% include date.liquid date=page.date %}</time>
      {% for category in page.categories -%}
        <a href="{{ category | slugify | prepend: '/blog/category/' | append: '/' | relative_url }}">
          {{- t.blog.categories[category] | default: category -}}
        </a>
      {%- endfor %}
      {% if page.tags.size > 0 -%}
        <span class="tags">
          {%- for tag in page.tags -%}
            <a href="{{ tag | slugify | prepend: '/blog/tag/' | append: '/' | relative_url }}">{{ tag }}</a>
          {%- endfor -%}
        </span>
      {%- endif %}
    </p>
  </header>

  <div class="article-layout {% if has_toc %}has-toc{% endif %}">
    {% if has_toc -%}
      <nav class="toc" aria-labelledby="toc-title">
        <h2 class="toc__title" id="toc-title">{{ t.blog.contents }}</h2>
        {{ toc }}
      </nav>
    {%- endif %}
    <div class="prose" data-copy="{{ t.publications.copy }}" data-copied="{{ t.publications.copied }}">
      {{ content | inject_anchors }}
    </div>
  </div>

  {% if site.giscus.repo -%}
    <section class="section comments" id="comments">
      <script
        src="https://giscus.app/client.js"
        data-repo="{{ site.giscus.repo }}"
        data-repo-id="{{ site.giscus.repo_id }}"
        data-category="{{ site.giscus.category }}"
        data-category-id="{{ site.giscus.category_id }}"
        data-mapping="{{ site.giscus.mapping | default: 'title' }}"
        data-strict="1"
        data-reactions-enabled="1"
        data-emit-metadata="0"
        data-input-position="bottom"
        data-theme="preferred_color_scheme"
        data-lang="{% if site.active_lang == 'zh-cn' %}zh-CN{% else %}en{% endif %}"
        crossorigin="anonymous"
        async
      ></script>
    </section>
  {%- endif %}

  {% if page.previous or page.next -%}
    <nav class="article-nav" aria-label="{{ t.blog.back }}">
      {% if page.previous -%}
        <a class="prev" href="{{ page.previous.url | relative_url }}">
          <span class="label">← {{ t.blog.older }}</span>
          <span class="title">{{ page.previous.title }}</span>
        </a>
      {%- endif %}
      {% if page.next -%}
        <a class="next" href="{{ page.next.url | relative_url }}">
          <span class="label">{{ t.blog.newer }} →</span>
          <span class="title">{{ page.next.title }}</span>
        </a>
      {%- endif %}
    </nav>
  {%- endif %}
</article>
