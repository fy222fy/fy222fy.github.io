<!doctype html>
<html lang="{% if site.active_lang == 'zh-cn' %}zh-CN{% else %}en{% endif %}">
  <head>
    {% if page.redirect -%}
      {%- if page.redirect == true -%}
        {%- assign redirect = site.baseurl | append: '/' -%}
      {%- elsif page.redirect contains '://' -%}
        {%- assign redirect = page.redirect -%}
      {%- else -%}
        {%- assign redirect = page.redirect | prepend: site.baseurl -%}
      {%- endif -%}
      <meta http-equiv="refresh" content="5; url={{ redirect }}">
    {%- endif %}
    {% include head.liquid %}
  </head>
  <body>
    <a class="skip-link" href="#main">{{ site.data[site.active_lang].strings.nav.skip }}</a>
    {% include header.liquid %}
    <main id="main">{{ content }}</main>
    {% include footer.liquid %}
    <script src="{{ '/assets/js/site.js' | relative_url | bust_file_cache }}" defer></script>
  </body>
</html>
