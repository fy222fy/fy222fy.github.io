---
layout: default
---
{%- assign t = site.data[site.active_lang].strings -%}
{%- assign repos = site.data[site.active_lang].repositories -%}
<div class="wrap">
  <header class="page-head">
    <h1>{{ page.title }}</h1>
    <p class="lead">{{ t.repositories.lead }}</p>
    <nav class="page-index" aria-label="{{ page.title }}">
      <a class="ext" href="https://github.com/{{ site.github_username }}">{{ t.repositories.profile }}</a>
    </nav>
  </header>
  <section class="section">
    <div class="cols-2">
      {% for item in repos -%}
        {%- assign parts = item.repo | split: '/' -%}
        <article class="repo">
          <p class="meta-line"><span class="tag">{{ item.role }}</span></p>
          <h2>
            <a href="https://github.com/{{ item.repo }}"><span class="owner">{{ parts[0] }}/</span>{{ parts[1] }}</a>
          </h2>
          <p>{{ item.text }}</p>
        </article>
      {%- endfor %}
    </div>
  </section>
</div>
