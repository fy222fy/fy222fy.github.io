---
{%- comment -%} One patent, software copyright or certificate, as a row in the CV. {%- endcomment -%}
{%- assign t = site.data[site.active_lang].strings.publications -%}
<div class="cv-ip">
  {%- if site.active_lang != 'zh-cn' and entry.title_en %}
    <span class="title" title="{{ entry.title }}">{{ entry.title_en }}</span>
  {%- else %}
    <span class="title" lang="zh-CN">{{ entry.title }}</span>
  {%- endif %}
  <span class="text">{{ t.kinds[entry.kind] | default: entry.abbr }} · {{ entry.number }}</span>
</div>
