<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{% include metadata.liquid %}
<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#111214" media="(prefers-color-scheme: dark)">

{% comment %} Decide the theme before the page is painted, so that it never flashes. {% endcomment %}
<script>
  (function () {
    var root = document.documentElement;
    root.classList.add('js');
    try {
      var theme = localStorage.getItem('theme');
      if (theme === 'light' || theme === 'dark') root.setAttribute('data-theme', theme);
    } catch (e) {}
  })();
</script>

{% comment %} Fonts are hosted with the site (see bin/build-fonts.py). Chinese fonts are split into small files that load as needed. {% endcomment %}
<link rel="preload" href="{{ '/assets/fonts/' | append: site.data.fonts.latin | relative_url }}" as="font" type="font/woff2" crossorigin>

<link rel="stylesheet" href="{{ '/assets/css/main.css' | relative_url | bust_css_cache }}">
{% if site.icon != blank -%}
  <link rel="icon" href="{{ site.icon | prepend: '/assets/img/' | relative_url | bust_file_cache }}">
{%- endif %}
<link rel="alternate" type="application/atom+xml" title="{{ site.first_name }} {{ site.last_name }}" href="{{ '/feed.xml' | relative_url }}">
