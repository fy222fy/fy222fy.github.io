{%- comment -%} Page title, description, social previews and structured data. {%- endcomment -%}
{%- assign t = site.data[site.active_lang].strings -%}
{%- capture author_name -%}{{ site.first_name }} {{ site.last_name }}{%- endcapture -%}
{%- if site.active_lang == 'zh-cn' -%}
  {%- assign site_name = '冯皓楠' -%}
  {%- assign home_title = '冯皓楠 · Haonan Feng' -%}
  {%- assign og_locale = 'zh_CN' -%}
{%- else -%}
  {%- assign site_name = author_name -%}
  {%- assign home_title = 'Haonan Feng · 冯皓楠' -%}
  {%- assign og_locale = 'en_US' -%}
{%- endif -%}
{%- if page.permalink == '/' or page.title == blank -%}
  {%- assign full_title = home_title -%}
{%- else -%}
  {%- capture full_title -%}{{ page.title | strip_html }} · {{ site_name }}{%- endcapture -%}
{%- endif -%}
{%- capture description -%}{{ page.description | default: t.site_description | strip_html | strip_newlines | strip }}{%- endcapture -%}
{%- capture page_url -%}{{ page.url | replace: 'index.html', '' | absolute_url }}{%- endcapture -%}
<title>{{ full_title | escape }}</title>
<meta name="author" content="{{ author_name }}">
<meta name="description" content="{{ description | escape }}">
{% if site.keywords -%}
  <meta name="keywords" content="{{ site.keywords }}">
{%- endif %}
<link rel="canonical" href="{{ page_url }}">
{% I18n_Headers %}
{% if site.serve_og_meta -%}
  <meta property="og:site_name" content="{{ site_name }}">
  <meta property="og:type" content="{% if page.layout == 'post' and page.inline != true %}article{% else %}website{% endif %}">
  <meta property="og:title" content="{{ full_title | escape }}">
  <meta property="og:description" content="{{ description | escape }}">
  <meta property="og:url" content="{{ page_url }}">
  <meta property="og:locale" content="{{ og_locale }}">
  {% if page.og_image or site.og_image -%}
    <meta property="og:image" content="{{ page.og_image | default: site.og_image }}">
  {%- endif %}
  <meta name="twitter:card" content="summary">
{%- endif %}
{% if site.serve_schema_org and page.permalink == '/' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "{{ author_name }}",
      "alternateName": "冯皓楠",
      "url": "{{ site.url }}{{ site.baseurl }}/",
      "image": "{{ site.og_image }}",
      "email": "mailto:{{ site.email }}",
      "jobTitle": "Ph.D. Student",
      "affiliation": {
        "@type": "CollegeOrUniversity",
        "name": "Beijing University of Posts and Telecommunications",
        "url": "https://www.bupt.edu.cn/"
      },
      "sameAs": [
        "https://scholar.google.com/citations?user={{ site.scholar_userid }}",
        "https://orcid.org/{{ site.orcid_id }}",
        "https://github.com/{{ site.github_username }}"
      ]
    }
  </script>
{%- endif %}
