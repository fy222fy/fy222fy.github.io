{%- assign t = site.data[site.active_lang].strings -%}
<footer class="site-footer">
  <div class="wrap">
    <div class="site-footer__inner">
      <p>&copy; {{ site.time | date: '%Y' }} Haonan Feng · <span lang="zh-CN">冯皓楠</span></p>
      <ul>
        <li>
          <a href="mailto:{{ site.email }}">{{ t.links.email }}</a>
        </li>
        <li>
          <a href="https://scholar.google.com/citations?user={{ site.scholar_userid }}">{{ t.links.scholar }}</a>
        </li>
        <li>
          <a href="https://orcid.org/{{ site.orcid_id }}">{{ t.links.orcid }}</a>
        </li>
        <li>
          <a href="https://github.com/{{ site.github_username }}">{{ t.links.github }}</a>
        </li>
      </ul>
    </div>
  </div>
</footer>
